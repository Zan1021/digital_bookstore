APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production: QUEUE_CONNECTION=redis and run `php artisan horizon` (task 5.2).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is pure PHP (works on Windows); phpredis needs the redis extension.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# First Super Admin, created by `php artisan db:seed --class=SuperAdminSeeder`.
# Leave SUPER_ADMIN_PASSWORD empty to set it later via "Forgot your password?".
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=

# AI cost ledger (config/ai.php): rand per US dollar for pricing AI calls
AI_USD_TO_ZAR=18.5
# AI model per operation (config/ai.php); leave unset for the defaults
# AI_TRANSLATE_MODEL=gpt-4o
# AI_TRANSLATE_FALLBACK_MODEL=gpt-4o-mini
# AI_METADATA_MODEL=gpt-4o
# AI_VISUAL_QA_MODEL=gpt-4o
# AI_LOCATE_ART_TEXT_MODEL=gpt-4o
# AI_ART_REPAIR_MODEL=gpt-image-1
# AI_NARRATE_MODEL=eleven_multilingual_v2
